{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scorpk",
  "version": "0.1.0",
  "identifier": "tech.scorpk.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scorpk",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://scorpk.tech"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["scorpk"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
